# Build-time public configuration. npm run build also loads .env.local (gitignored).
# Leave SITE_URL empty until the real public HTTPS origin is known.
SITE_URL=
# Mandatory in Cloudflare builds; match the production branch in the Pages dashboard.
PRODUCTION_BRANCH=andre
# Only the exact content value supplied by Google, without the surrounding meta tag.
GOOGLE_SITE_VERIFICATION=
